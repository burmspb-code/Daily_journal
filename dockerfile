# ==========================================
# ШАГ 1: ВЫБОР БАЗОВОГО ОБРАЗА
# ==========================================
# Используем официальный облегченный образ Python 3.14 на базе Debian Linux.
# Тег "slim" гарантирует минимальный вес (около 150 МБ) и отсутствие системного мусора.
FROM python:3.14-slim

# ==========================================
# ШАГ 2: УСТАНОВКА СИСТЕМНЫХ ЗАВИСИМОСТЕЙ
# ==========================================
# Для сборки библиотек на C (pillow, psycopg2) и установки Poetry нужны утилиты.
# Объединяем команды в одну цепочку через '&&', чтобы уменьшить количество слоев Docker.
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*
# Разбор флагов:
# -y : Автоматически соглашаться на установку пакетов (без подтверждения в консоли).
# --no-install-recommends : Не ставить лишние рекомендуемые пакеты (экономия места).
# rm -rf /var/lib/apt/lists/* : Удаляет временный кэш пакетов после установки, снижая вес образа.

# ==========================================
# ШАГ 3: НАСТРОЙКА ПЕРЕМЕННЫХ ОКРУЖЕНИЯ (ENV)
# ==========================================
# Эти переменные настраивают поведение Python и пакетного менеджера Poetry.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VERSION=2.2.1 \
    POETRY_HOME="/opt/poetry" \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1
# Разбор переменных:
# PYTHONDONTWRITEBYTECODE=1 : Запрещает Python генерировать файлы кэша .pyc на диске контейнера.
# PYTHONUNBUFFERED=1 : Отключает буферизацию вывода. Логи (включая print() и ошибки) мгновенно попадают в консоль Docker.
# POETRY_VERSION=2.2.1 : Фиксирует конкретную версию Poetry, которую мы хотим установить.
# POETRY_HOME="/opt/poetry" : Указывает Docker, в какую системную папку установить файлы Poetry.
# POETRY_VIRTUALENVS_CREATE=false : КРИТИЧЕСКИ ВАЖНО! Отключает создание виртуальных окружений (.venv) внутри контейнера.
# Поскольку Docker-контейнер САМ по себе изолирован, Poetry установит библиотеки прямо в глобальное окружение контейнера.

# ==========================================
# ШАГ 4: УСТАНОВКА ПОКАЗАТЕЛЕЙ ПУТИ И POETRY
# ==========================================
# Скачиваем и запускаем официальный скрипт установки Poetry с помощью curl.
# ВАЖНО: без проверки ниже сетевой сбой в curl превращался бы в «тихий» успех
# (sh берет код возврата последнего команды в конвейере — python, читающего
# пустой stdin), и сборка падала бы уже на шаге "poetry: not found").
RUN curl -sSL https://install.python-poetry.org | python3 - --version $POETRY_VERSION \
    && test -x "$POETRY_HOME/bin/poetry" \
    && "$POETRY_HOME/bin/poetry" --version

# Добавляем путь к исполняемому файлу Poetry в системную переменную PATH,
# чтобы операционная система контейнера знала команду "poetry"
ENV PATH="$POETRY_HOME/bin:$PATH"

# ==========================================
# ШАГ 5: ПОДГОТОВКА СЛОЯ ЗАВИСИМОСТЕЙ
# ==========================================
# Задаем главную рабочую директорию внутри контейнера. Все последующие команды будут выполняться в ней.
WORKDIR /app

# Копируем файлы конфигурации Poetry с вашего компьютера внутрь контейнера.
# Мы копируем ИХ ДО копирования основного кода проекта. Это магия кэширования Docker:
# если ваши зависимости не менялись, Docker пропустит тяжелый шаг установки библиотек при следующей сборке.
COPY pyproject.toml poetry.lock* /app/

# Запускаем установку всех библиотек проекта вместе с группой dev
# (там лежат ruff, pytest, pytest-django, factory-boy — они нужны,
# чтобы прогонять тесты и линтер прямо внутри контейнера).
# Флаг --no-root указывает не пытаться устанавливать сам текущий проект как пакет ( package-mode = false )
RUN poetry install --no-interaction --no-ansi --with dev
# Разбор флагов:
# --no-interaction : Запрещает Poetry задавать интерактивные вопросы в терминале.
# --no-ansi : Отключает цветное форматирование логов во время сборки для чистоты вывода.

# ==========================================
# ШАГ 6: КОПИРОВАНИЕ ИСХОДНОГО КОДА
# ==========================================
# Копируем абсолютно все файлы вашего проекта из текущей папки компьютера в папку /app контейнера.
COPY . /app/

# Примечание: Инструкцию CMD (команду по умолчанию) мы здесь намеренно НЕ пишем.
# Вместо этого мы будем гибко задавать разные команды запуска для Django, Celery и Celery Beat
# прямо внутри файла docker-compose.yml, используя один и тот же собранный образ.

# Открываем порт для Gunicorn (внутри сети Docker)
EXPOSE 8000
