# =============================================================================
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# =============================================================================
# Скопируйте файл в .env и заполните значения:
#     cp .env.sample .env
#
# ВАЖНО: реальный .env содержит секреты и НЕ должен попадать в git
# (он уже добавлен в .gitignore). На продакшене значения передаются
# через секреты CI/CD или переменные окружения хостинга.
# =============================================================================

# --- Основные настройки Django ---
# Сгенерировать ключ: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True — только для локальной разработки. На продакшене обязательно False.
DEBUG=

# Хосты через запятую, БЕЗ схемы и порта.
# Пример: localhost,127.0.0.1,example.com,www.example.com
ALLOWED_HOSTS=

# Домены для CSRF через HTTPS — СО СХЕМОЙ, через запятую.
# Нужны только на продакшене за reverse-proxy. Пример: https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=

# --- База данных PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Отправка почтовых уведомлений ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Celery (необязательно) ---
# По умолчанию используется redis://redis:6379/0 (docker-compose переопределяет сам).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Служебные адреса ---
EMAIL_ADMIN_NOTIFICATION=

ADMIN_EMAIL=
ADMIN_PASSWORD=
